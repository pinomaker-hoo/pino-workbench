{
  "name": "pino-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first desktop workbench for MCP-connected work context and API scenarios",
  "license": "MIT",
  "author": "Pino Workbench contributors",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test:desktop": "npm run build && node tests/desktop.mjs && node tests/api-desktop.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.7"
  },
  "build": {
    "appId": "dev.pino.workspace",
    "productName": "Pino Workbench",
    "files": [
      "dist-electron/**",
      "dist/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pinomaker-hoo/pino-workbench.git"
  },
  "homepage": "https://github.com/pinomaker-hoo/pino-workbench#readme",
  "bugs": {
    "url": "https://github.com/pinomaker-hoo/pino-workbench/issues"
  }
}
